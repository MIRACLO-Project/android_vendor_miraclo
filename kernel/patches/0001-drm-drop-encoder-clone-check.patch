From: PSP <78963354+PSP-HUB@users.noreply.github.com>
Subject: [PATCH] aurora: drm: drop the encoder clone check from atomic modeset

Linux 5.10.238+ picked up "drm: Add valid clones check", which rejects any
atomic commit whose CRTC drives encoders that do not list each other in
possible_clones. The marble display driver attaches its writeback encoder
(concurrent writeback, used to sample the screen) to the active DSI CRTC
without declaring them as clones, so every such frame fails with -EINVAL
and the display HAL falls back to a null commit: the screen flickers.

The stock GKI kernel (5.10.236) does not have this check. Drop it so the
vendor display driver behaves exactly as on stock.

--- a/drivers/gpu/drm/drm_atomic_helper.c
+++ b/drivers/gpu/drm/drm_atomic_helper.c
@@ -557,30 +557,6 @@
 	return 0;
 }
 
-static int drm_atomic_check_valid_clones(struct drm_atomic_state *state,
-					 struct drm_crtc *crtc)
-{
-	struct drm_encoder *drm_enc;
-	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state,
-									  crtc);
-
-	drm_for_each_encoder_mask(drm_enc, crtc->dev, crtc_state->encoder_mask) {
-		if (!drm_enc->possible_clones) {
-			DRM_DEBUG("enc%d possible_clones is 0\n", drm_enc->base.id);
-			continue;
-		}
-
-		if ((crtc_state->encoder_mask & drm_enc->possible_clones) !=
-		    crtc_state->encoder_mask) {
-			DRM_DEBUG("crtc%d failed valid clone check for mask 0x%x\n",
-				  crtc->base.id, crtc_state->encoder_mask);
-			return -EINVAL;
-		}
-	}
-
-	return 0;
-}
-
 /**
  * drm_atomic_helper_check_modeset - validate state object for modeset changes
  * @dev: DRM device
@@ -744,10 +720,6 @@
 		ret = drm_atomic_add_affected_planes(state, crtc);
 		if (ret != 0)
 			return ret;
-
-		ret = drm_atomic_check_valid_clones(state, crtc);
-		if (ret != 0)
-			return ret;
 	}
 
 	/*
