// Mira Dolby: controls the Dolby Atmos engine in the phone's vendor image (profiles, intelligent
// and graphic equalizer, surround, dialogue, leveller), with the EasyEffects presets on top,
// per-app profiles and a Quick Settings tile. Starts with the phone and keeps the sound applied.
android_app {
    name: "MiraDolby",
    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],
    asset_dirs: ["assets"],
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    platform_apis: true,
}
